{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://carbonvault-api.onrender.com/:match*"
    },
    {
      "source": "/realtime/:match*",
      "destination": "https://carbonvault-api.onrender.com/realtime/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
