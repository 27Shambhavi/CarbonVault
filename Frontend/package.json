{
  "name": "carbonvault",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "check:mockdata": "node scripts/check-no-mockdata.js",
    "check:hardcoded": "node scripts/check-hardcoded-runner.js",
    "lint": "node scripts/check-no-mockdata.js && node scripts/check-hardcoded-runner.js && eslint src",
    "prebuild": "node scripts/check-no-mockdata.js && node scripts/check-hardcoded-runner.js && npm run lint",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  }
}
